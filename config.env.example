# 非機密設定；機密（api_id / api_hash / 手機）放 .env

# 排程要撥的對象（username，不含 @）
TARGET_USERNAME=
# --now 測試時撥的對象；不能是登入帳號本身（Telegram 不能打給自己）
SELF_TEST_USERNAME=

# 單次響鈴最多幾秒沒接就掛斷
RING_TIMEOUT=45
# 沒接時，間隔幾秒後重撥
RETRY_INTERVAL=60
# 第一通沒接後最多再重撥幾次；unlimited = 不限，撥到接起來為止（仍受 GIVE_UP_AT 限制）
MAX_REDIALS=unlimited
# 安全上限：台北時間到這個時刻就不再撥，改傳 FALLBACK_MESSAGE（HH:MM，空白 = 不限）
GIVE_UP_AT=08:00
# 接通後播放幾秒再掛斷
PLAY_SECONDS=60
# 全部沒接通時傳的文字訊息
FALLBACK_MESSAGE=起床了
# 預設鬧鈴（ALARM_DIR 是空的或檔案都讀不到時才用）
ALARM_FILE=alarm.mp3
# 隨機鬧鈴資料夾：每通隨機挑一首（mp3/m4a/aac/wav/ogg/opus/flac/webm），加檔案不用重啟
ALARM_DIR=alarms

# ===== 群組預約 bot（bot.py）=====
# 群組 id（逗號分隔，例如 -1001234567890）：群組內指令只限管理者；這些群組的成員可以私訊 alarm MMDD HHMM 預約
BOT_GROUP_IDS=
# 管理者 user id（逗號分隔，可以預約任何人、取消任何預約）；其他人只能預約自己
BOT_ADMIN_IDS=
# 群組預約：每通響鈴秒數、重撥間隔、從開始撥算起最多撥幾分鐘
GROUP_RING_TIMEOUT=45
GROUP_RETRY_INTERVAL=60
GROUP_MAX_MINUTES=30
# 每個人（管理者除外）同時最多幾筆未執行的預約、最多預約幾天後
GROUP_MAX_PENDING_PER_USER=3
GROUP_MAX_DAYS_AHEAD=14
